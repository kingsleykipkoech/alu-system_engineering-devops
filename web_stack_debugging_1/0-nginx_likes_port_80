#!/usr/bin/env bash
# Configures Nginx to listen on port 80 and ensures the service is running

sed -i 's/8080/80/g' /etc/nginx/sites-available/default 2>/dev/null
sed -i 's/8080/80/g' /etc/nginx/sites-enabled/default 2>/dev/null
ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default 2>/dev/null
service nginx restart 2>/dev/null || service nginx start 2>/dev/null
